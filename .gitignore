# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.aider*

# agent/tooling artifacts
.agent/
.agents/
.qwen/
skills-lock.json

# gemini
.gemini/

# Markdown dosyalarını görmezden gel ama README'yi tut
*.md
!README.md
!readme.md
*.md
*.jsonc

# service account keys
*-*.json
!src/data/courses.json

# Keep OpenAgents project context and configuration versioned
!.opencode/
!.opencode/**
!.opencode/.gitignore

# Keep local/generated OpenAgents dependencies and package artifacts ignored
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

# Temporary agent sessions
.tmp/
.opencode/tmp/
